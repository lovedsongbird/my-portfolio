<script is:inline>
// 0. DARK MODE LOGIC
  const themeToggle = document.getElementById('theme-toggle');
  
  // Checks if user previously selected dark mode
  const currentTheme = localStorage.getItem('theme') || 'light';
  document.documentElement.setAttribute('data-theme', currentTheme);

  // Fires the toggle animation and swaps CSS variables
  themeToggle.addEventListener('click', () => {
    const newTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  });

  // 1. FAST CUSTOM CURSOR
  const cursor = document.getElementById('cursor');
  document.addEventListener('mousemove', e => {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top = e.clientY + 'px';
  });

  // 2. CINEMATIC SCROLL FOCUS (JS Safety Net + One-Way Reveal)
  document.body.classList.add('js-ready'); 

  const focusSections = document.querySelectorAll('.focus-section, .work-card');
  const focusOptions = {
    root: null,
    rootMargin: '0px 0px -15% 0px', 
    threshold: 0.05 
  };
  
  const focusObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-focus');
        focusObserver.unobserve(entry.target); // Reveal once, never hide again
      }
    });
  }, focusOptions);

  focusSections.forEach(sec => focusObserver.observe(sec));

  // 3. MODAL LOGIC
  const modalBackdrop = document.getElementById('modal-backdrop');
  const modalContainer = document.getElementById('modal-container');
  const modalBody = document.getElementById('modal-body');
  const closeBtn = document.getElementById('modal-close');
  const cards = document.querySelectorAll('.work-card');
  const totalProjects = 5;

function openModal(id, isSlide = false) {
    const tpl = document.getElementById('tpl-' + id);
    if(!tpl) return;
    
    modalBody.innerHTML = '';
    const clone = tpl.content.cloneNode(true);
    modalBody.appendChild(clone);
    
    // Calculate Next ID & Grab the short Meta span!
    const nextId = parseInt(id) === totalProjects ? 1 : parseInt(id) + 1;
    const nextCard = document.querySelector(`.work-card[data-project="${nextId}"]`);
    const nextTitle = nextCard ? nextCard.querySelector('h3').innerText : '';
    const nextSubtitle = nextCard ? nextCard.querySelector('.meta span').innerText : '';

    // Calculate Prev ID & Grab the short Meta span!
    const prevId = parseInt(id) === 1 ? totalProjects : parseInt(id) - 1;
    const prevCard = document.querySelector(`.work-card[data-project="${prevId}"]`);
    const prevTitle = prevCard ? prevCard.querySelector('h3').innerText : '';
    const prevSubtitle = prevCard ? prevCard.querySelector('.meta span').innerText : '';
    
    // Build Navigation Footer
    const navFooter = document.createElement('div');
    navFooter.className = 'project-nav-wrapper';
    navFooter.innerHTML = `
      <div style="display: flex; flex-direction: column;">
        <div class="nav-label">PREVIOUS PROJECT</div>
        <button class="nav-card prev" onclick="flipToProject(${prevId})" style="flex-grow: 1; height: 100%;">
          <!-- ARROW FIRST so it sits on the left! -->
          <span class="nav-card-arrow">←</span>
          <div class="nav-card-info">
            <span class="nav-card-title">${prevTitle}</span>
            <span class="nav-card-subtitle">${prevSubtitle}</span>
          </div>
        </button>
      </div>
      <div style="display: flex; flex-direction: column;">
        <div class="nav-label">NEXT PROJECT</div>
        <button class="nav-card next" onclick="flipToProject(${nextId})" style="flex-grow: 1; height: 100%;">
          <!-- TEXT FIRST so the arrow gets pushed to the right! -->
          <div class="nav-card-info">
            <span class="nav-card-title">${nextTitle}</span>
            <span class="nav-card-subtitle">${nextSubtitle}</span>
          </div>
          <span class="nav-card-arrow">→</span>
        </button>
      </div>
    `;
    modalBody.appendChild(navFooter);

    if (!isSlide) {
      modalBackdrop.classList.add('is-open');
      modalContainer.classList.add('is-open');
      closeBtn.classList.add('is-open'); 
      document.body.classList.add('modal-open');
    }
    modalContainer.scrollTop = 0;
  }

  window.flipToProject = function(nextId) {
    modalBody.classList.add('fast-fade-out');
    setTimeout(() => {
      openModal(nextId, true); 
      modalBody.classList.remove('fast-fade-out');
      modalBody.classList.add('fast-fade-in');
      setTimeout(() => { modalBody.classList.remove('fast-fade-in'); }, 150);
    }, 150);
  };

  function closeModal() {
    modalBackdrop.classList.remove('is-open');
    modalContainer.classList.remove('is-open');
    closeBtn.classList.remove('is-open');
    document.body.classList.remove('modal-open');
  }

  cards.forEach(card => card.addEventListener('click', () => openModal(card.dataset.project)));
  closeBtn.addEventListener('click', closeModal);
  modalBackdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { 
    if (e.key === 'Escape') {
      const lightbox = document.getElementById('lightbox');
      // If the lightbox is open, do nothing here (let the lightbox script close itself)
      if (lightbox && lightbox.classList.contains('is-open')) return;
      
      closeModal(); 
    } 
  });
  // =========================================
  // LIGHTBOX GALLERY LOGIC
  // =========================================
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const btnCloseLightbox = document.getElementById('lightbox-close');
  const btnPrev = document.getElementById('lightbox-prev');
  const btnNext = document.getElementById('lightbox-next');

  let currentGallery = [];
  let currentIndex = 0;

  // Smart Event Listener: Looks for ANY image clicked inside the modal
  document.addEventListener('click', (e) => {
    if (e.target.tagName === 'IMG' && e.target.closest('#modal-body')) {
      // Automatically build a gallery out of all images in the open modal
      currentGallery = Array.from(document.querySelectorAll('#modal-body img'));
      currentIndex = currentGallery.indexOf(e.target);
      
      // Inject the source and open the lightbox
      lightboxImg.src = e.target.src;
      lightbox.classList.add('is-open');
    }
  });

  const updateLightbox = () => {
    lightboxImg.src = currentGallery[currentIndex].src;
  };

  btnPrev.addEventListener('click', () => {
    currentIndex = (currentIndex === 0) ? currentGallery.length - 1 : currentIndex - 1;
    updateLightbox();
  });

  btnNext.addEventListener('click', () => {
    currentIndex = (currentIndex === currentGallery.length - 1) ? 0 : currentIndex + 1;
    updateLightbox();
  });

  const closeLightbox = () => lightbox.classList.remove('is-open');
  if (btnCloseLightbox) btnCloseLightbox.addEventListener('click', closeLightbox);

  // CLOSE ON BACKGROUND OR IMAGE CLICK
  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      // If the user clicked the next/prev arrows or the close button, do nothing (let them work)
      if (e.target.closest('.lightbox-btn')) return;
      
      // If they clicked anywhere else (the background OR the giant invisible image box), close it!
      closeLightbox();
    });
  }

  // Keyboard Support (Escape to close, Arrows to navigate)
  document.addEventListener('keydown', (e) => {
    if (!lightbox || !lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') btnPrev.click();
    if (e.key === 'ArrowRight') btnNext.click();
  });
</script>

</body>
</html>