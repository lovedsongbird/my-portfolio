---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Creative Portfolio | Selected Works & Visual Art", 
  description = "Independent creative portfolio specializing in large-format visual art, studio painting, and commissioned installations.",
  image = "/og-image.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://example.com");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / LinkedIn / iMessage -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Favicon: Clean SVG dot icon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23171717'/></svg>" />

    <!-- Inline script to prevent theme flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100 min-h-screen flex flex-col antialiased selection:bg-neutral-200 dark:selection:bg-neutral-800 transition-colors duration-200">
    <header class="max-w-5xl mx-auto w-full px-6 py-8 flex justify-between items-center">
      <a href="/" class="text-xl font-bold tracking-tight hover:opacity-80 transition-opacity">Portfolio.</a>
      <div class="flex items-center gap-6">
        <nav class="flex gap-6 text-sm text-neutral-600 dark:text-neutral-400">
          <a href="#work" class="hover:text-black dark:hover:text-white transition-colors">Work</a>
          <a href="#about" class="hover:text-black dark:hover:text-white transition-colors">About</a>
          <a href="#contact" class="hover:text-black dark:hover:text-white transition-colors">Contact</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main class="flex-grow max-w-5xl mx-auto w-full px-6">
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto w-full px-6 py-8 text-center text-xs text-neutral-500 border-t border-neutral-200 dark:border-neutral-900 mt-20">
      <p>© {new Date().getFullYear()} All rights reserved.</p>
    </footer>
  </body>
</html>